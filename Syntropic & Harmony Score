"""
Constraint mechanisms for applying intentional steering and neuromodulation.
"""

import cmath
from typing import List, Set, Dict, Tuple

def apply_neuromodulation(H: List[Tuple[int, int, complex]], 
                         neighbors: Dict[int, Set[int]],
                         novelty_target: int,
                         modulation_strength: float = 0.5) -> List[Tuple[int, int, complex]]:
    """
    Apply neuromodulation: strengthen pathways that lead toward the novelty target.
    """
    distances = {novelty_target: 0}
    queue = [novelty_target]
    
    while queue:
        current = queue.pop(0)
        for neighbor in neighbors.get(current, set()):
            if neighbor not in distances:
                distances[neighbor] = distances[current] + 1
                queue.append(neighbor)
    
    H_modulated = []
    for row, col, coupling in H:
        if row != col and row in distances and col in distances:
            if distances[col] < distances[row]:
                new_strength = abs(coupling) * (1.0 + modulation_strength)
                phase = cmath.phase(coupling)
                new_coupling = new_strength * cmath.exp(1j * phase)
                H_modulated.append((row, col, new_coupling))
            else:
                H_modulated.append((row, col, coupling))
        else:
            H_modulated.append((row, col, coupling))
    
    return H_modulated


def apply_intention_steering(H: List[Tuple[int, int, complex]],
                            dominant_states: Set[int],
                            novelty_target: int,
                            steering_strength: float = 0.6) -> List[Tuple[int, int, complex]]:
    """
    Apply coherent intention steering from dominant states to novelty target.
    """
    H_intention = list(H)
    
    for state in dominant_states:
        H_intention.append((novelty_target, state, complex(0.0, steering_strength)))
        H_intention.append((state, novelty_target, complex(0.0, -steering_strength)))
    
    return H_intention


def apply_blind_suppression(H: List[Tuple[int, int, complex]],
                           constrained_states: Set[int],
                           suppression_strength: float = 1.5) -> List[Tuple[int, int, complex]]:
    """
    Apply blind suppression: add diagonal energy penalties to constrained states.
    """
    H_suppressed = list(H)
    
    for state in constrained_states:
        H_suppressed.append((state, state, complex(suppression_strength, 0.0)))
    
    return H_suppressed

