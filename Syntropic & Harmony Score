"""
Quantum evolution through topological networks.
"""

import cmath
import math
import random
from typing import Dict, List, Tuple, Optional

def inner_product(v1: List[complex], v2: List[complex]) -> complex:
    return sum(a.conjugate() * b for a, b in zip(v1, v2))

def norm(v: List[complex]) -> float:
    return math.sqrt(inner_product(v, v).real)

def normalize(v: List[complex]) -> List[complex]:
    n = norm(v)
    if n == 0:
        return v
    return [x / n for x in v]

def apply_sparse_hamiltonian(psi: List[complex], H: List[Tuple[int, int, complex]]) -> List[complex]:
    result = [complex(0, 0)] * len(psi)
    for row, col, coupling in H:
        result[row] += coupling * psi[col]
    return result

def add_vectors(v1: List[complex], v2: List[complex]) -> List[complex]:
    return [a + b for a, b in zip(v1, v2)]

def scale_vector(v: List[complex], scalar: complex) -> List[complex]:
    return [x * scalar for x in v]


def run_quantum_evolution(H: List[Tuple[int, int, complex]], 
                         transition_map: Dict,
                         dim: int = 256, 
                         steps: int = 10, 
                         dt: float = 0.1,
                         source_states: Optional[List[int]] = None) -> Dict[Tuple[int, int], float]:
    """
    Run quantum evolution through the network using midpoint method.
    """
    if source_states is None:
        source_states = list(range(dim))
    
    transition_probs = {}
    
    for source_state in source_states:
        psi = [complex(0, 0)] * dim
        psi[source_state] = complex(1.0, 0.0)
        
        for _ in range(steps):
            k1 = apply_sparse_hamiltonian(psi, H)
            k1 = scale_vector(k1, -1j)
            psi_mid = add_vectors(psi, scale_vector(k1, dt / 2.0))
            
            k2 = apply_sparse_hamiltonian(psi_mid, H)
            k2 = scale_vector(k2, -1j)
            psi_next = add_vectors(psi, scale_vector(k2, dt))
            
            psi = normalize(psi_next)
        
        for target_state in range(dim):
            if target_state == source_state:
                continue
            if (source_state, target_state) in transition_map:
                prob = abs(psi[target_state])**2
                transition_probs[(source_state, target_state)] = prob
    
    return transition_probs


def build_hamiltonian(topology, coupling_strength: float = 2.5) -> Tuple[List, Dict]:
    """
    Build a sparse Hamiltonian from a topology.
    """
    H = []
    transition_map = {}
    
    for i, j in topology.edges:
        c = complex(coupling_strength, random.uniform(-0.3, 0.3))
        H.append((i, j, c))
        transition_map[(i, j)] = 1
    
    for i in topology.nodes:
        H.append((i, i, complex(0.0, 0.0)))
    
    return H, transition_map

