"""
Topology builders for creating and loading network structures.
"""

import random
from typing import List, Tuple, Set, Dict, Optional

class Topology:
    """
    Represents a topological network with nodes and directed edges.
    """
    
    def __init__(self, nodes: List[int], edges: List[Tuple[int, int]], 
                 weights: Optional[Dict[Tuple[int, int], complex]] = None):
        self.nodes = nodes
        self.edges = edges
        self.weights = weights or {}
        self.neighbors = {node: set() for node in nodes}
        self.degrees = {node: 0 for node in nodes}
        
        for i, j in edges:
            self.neighbors[i].add(j)
            self.neighbors[j].add(i)
            self.degrees[i] += 1
            self.degrees[j] += 1
    
    @property
    def num_nodes(self) -> int:
        return len(self.nodes)
    
    @property
    def num_edges(self) -> int:
        return len(self.edges)
    
    def get_neighbors(self, node: int) -> Set[int]:
        return self.neighbors.get(node, set())
    
    def get_degree(self, node: int) -> int:
        return self.degrees.get(node, 0)


class TopologyBuilder:
    """
    Factory class for building different types of topologies.
    """
    
    @staticmethod
    def hamming_distance_graph(dim: int = 256, target_edges: int = 1296) -> Topology:
        """
        Build a Hamming-distance graph (8-bit binary strings).
        """
        def hamming_distance(a, b):
            xor_val = a ^ b
            distance = 0
            while xor_val:
                distance += xor_val & 1
                xor_val >>= 1
            return distance
        
        def get_signature_class(d):
            if d == 1: return 1
            if d == 2: return 2
            if d == 3: return 3
            if d in (4, 5): return 4
            return 5
        
        edges_by_class = {c: [] for c in range(1, 6)}
        
        for i in range(dim):
            for j in range(i + 1, dim):
                d = hamming_distance(i, j)
                sig_class = get_signature_class(d)
                weight = 1.0 / (1.0 + d)**2
                edges_by_class[sig_class].append((i, j, weight, d))
        
        for c in edges_by_class:
            edges_by_class[c].sort(key=lambda x: x[2], reverse=True)
        
        target_pairs = target_edges // 2
        allocation = {
            1: int(target_pairs * 0.40),
            2: int(target_pairs * 0.25),
            3: int(target_pairs * 0.15),
            4: int(target_pairs * 0.12),
            5: target_pairs - (259 + 162 + 97 + 78)
        }
        
        edges = set()
        for sig_class in range(1, 6):
            available = edges_by_class[sig_class]
            selected = available[:allocation[sig_class]]
            for i, j, weight, d in selected:
                edges.add((i, j))
                edges.add((j, i))
        
        edges_list = list(edges)
        random.shuffle(edges_list)
        selected_edges = edges_list[:target_edges]
        
        return Topology(list(range(dim)), selected_edges)
    
    @staticmethod
    def small_world(n: int = 256, k: int = 6, p: float = 0.1, 
                   target_edges: int = 1296) -> Topology:
        """
        Build a Watts-Strogatz small-world network.
        """
        edges = set()
        
        for i in range(n):
            for j in range(1, k // 2 + 1):
                neighbor = (i + j) % n
                edges.add((i, neighbor))
                edges.add((neighbor, i))
        
        edges_list = list(edges)
        rewired = set()
        for edge in edges_list:
            if random.random() < p:
                i, j = edge
                new_j = random.randint(0, n - 1)
                attempts = 0
                while (new_j == i or (i, new_j) in rewired) and attempts < 10:
                    new_j = random.randint(0, n - 1)
                    attempts += 1
                if attempts < 10:
                    rewired.add((i, new_j))
                    rewired.add((new_j, i))
                else:
                    rewired.add(edge)
            else:
                rewired.add(edge)
        
        rewired_list = list(rewired)
        random.shuffle(rewired_list)
        selected = rewired_list[:target_edges]
        
        return Topology(list(range(n)), selected)
    
    @staticmethod
    def hierarchical(n: int = 256, num_modules: int = 4, 
                    intra_k: int = 6, target_edges: int = 1296) -> Topology:
        """
        Build a hierarchical modular network.
        """
        module_size = n // num_modules
        edges = set()
        
        for module in range(num_modules):
            start = module * module_size
            end = start + module_size
            
            for i in range(start, end):
                for j in range(1, intra_k // 2 + 1):
                    neighbor = start + ((i - start + j) % module_size)
                    edges.add((i, neighbor))
                    edges.add((neighbor, i))
            
            module_edges = [(i, j) for (i, j) in edges 
                          if start <= i < end and start <= j < end]
            for edge in module_edges:
                if random.random() < 0.1:
                    i, j = edge
                    new_j = random.randint(start, end - 1)
                    if new_j != i:
                        edges.discard(edge)
                        edges.discard((j, i))
                        edges.add((i, new_j))
                        edges.add((new_j, i))
        
        hub_nodes = []
        for module in range(num_modules):
            start = module * module_size
            end = start + module_size
            module_hubs = random.sample(range(start, end), module_size // 10)
            hub_nodes.extend(module_hubs)
        
        for i in range(len(hub_nodes)):
            for j in range(i + 1, len(hub_nodes)):
                if random.random() < 0.3:
                    edges.add((hub_nodes[i], hub_nodes[j]))
                    edges.add((hub_nodes[j], hub_nodes[i]))
        
        edges_list = list(edges)
        random.shuffle(edges_list)
        selected = edges_list[:target_edges]
        
        return Topology(list(range(n)), selected)
    
    @staticmethod
    def c_elegans() -> Topology:
        """
        Build a topologically accurate model of the C. elegans connectome.
        """
        dim = 302
        target_edges = 7500
        module_sizes = [75, 80, 75, 72]
        biological_hubs = [15, 155, 230, 285]
        
        edges = set()
        
        current_idx = 0
        for size in module_sizes:
            start = current_idx
            end = current_idx + size
            for i in range(start, end):
                for j in range(1, 5):
                    neighbor = start + ((i - start + j) % size)
                    edges.add((i, neighbor))
                    edges.add((neighbor, i))
            current_idx += size
        
        for hub in biological_hubs:
            for i in range(dim):
                if i != hub and random.random() < 0.15:
                    edges.add((hub, i))
                    edges.add((i, hub))
        
        while len(edges) < target_edges:
            i = random.randint(0, dim - 1)
            j = random.randint(0, dim - 1)
            if i != j and (i, j) not in edges:
                edges.add((i, j))
        
        edges_list = list(edges)
        random.seed(42)
        random.shuffle(edges_list)
        selected = edges_list[:target_edges]
        
        return Topology(list(range(dim)), selected)
    
    @staticmethod
    def from_adjacency_matrix(matrix: List[List[int]]) -> Topology:
        """
        Build topology from an adjacency matrix.
        """
        n = len(matrix)
        edges = []
        for i in range(n):
            for j in range(n):
                if matrix[i][j] > 0:
                    edges.append((i, j))
        
        return Topology(list(range(n)), edges)


