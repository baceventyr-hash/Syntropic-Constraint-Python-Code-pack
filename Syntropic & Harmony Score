"""
Mathematical metrics for measuring structured constraint and syntropic harmony.
"""

import math
from typing import List, Dict
from dataclasses import dataclass

@dataclass
class HarmonyResult:
    """
    Container for all Harmony Score metrics.
    """
    harmony_score: float
    amplification: float
    gini: float
    friction: float
    total_reductions: int
    top_10_mass: float
    top_25_mass: float
    
    def __str__(self):
        return (
            f"HarmonyResult(\n"
            f"  harmony_score={self.harmony_score:.4f}\n"
            f"  amplification={self.amplification:.1f}x\n"
            f"  gini={self.gini:.3f}\n"
            f"  friction={self.friction:.4f}\n"
            f"  total_reductions={self.total_reductions}\n"
            f"  top_10_mass={self.top_10_mass*100:.1f}%\n"
            f"  top_25_mass={self.top_25_mass*100:.1f}%\n"
            f")"
        )


def calculate_gini(values: List[float]) -> float:
    """
    Calculate the Gini coefficient of a list of values.
    """
    if not values or sum(values) == 0:
        return 0.0
    
    sorted_vals = sorted(values)
    n = len(sorted_vals)
    cumsum = 0.0
    weighted_sum = 0.0
    
    for i, val in enumerate(sorted_vals):
        cumsum += val
        weighted_sum += (i + 1) * val
    
    return (2.0 * weighted_sum) / (n * cumsum) - (n + 1.0) / n


def calculate_amplification(baseline_prob: float, intentional_prob: float) -> float:
    """
    Calculate the amplification factor of probability flow to a target.
    """
    baseline = max(baseline_prob, 1e-10)
    return intentional_prob / baseline


def calculate_friction(reductions: Dict, total_edges: int) -> float:
    """
    Calculate topological friction (normalized total reductions).
    """
    total_reduction = sum(reductions.values())
    return total_reduction / total_edges if total_edges > 0 else 0.0


def calculate_harmony_score(amplification: float, gini: float, friction: float) -> float:
    """
    Calculate the Harmony Score (H).
    
    H = (Amplification × Structured Capacity) / (1 + Topological Friction)
    """
    return (amplification * gini) / (1.0 + friction)


