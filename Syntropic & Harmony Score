"""
Main HarmonyCalculator API for computing the Harmony Score.
"""

import random
from typing import Dict, List, Set, Optional
from .topology import Topology
from .evolution import run_quantum_evolution, build_hamiltonian
from .constraint import (apply_neuromodulation, apply_intention_steering, 
                        apply_blind_suppression)
from .metrics import (calculate_gini, calculate_amplification, 
                     calculate_friction, calculate_harmony_score, HarmonyResult)


class HarmonyCalculator:
    """
    Main API for calculating the Harmony Score of a topological system.
    """
    
    def __init__(self, topology: Topology):
        self.topology = topology
        self.dim = topology.num_nodes
    
    def calculate(self, 
                 baseline_state: Dict,
                 intention: Dict,
                 evolution_steps: int = 8,
                 dt: float = 0.1,
                 learning_rate: float = 0.05) -> HarmonyResult:
        """
        Calculate the Harmony Score for a given baseline state and intentional shift.
        """
        H_base, transition_map = build_hamiltonian(self.topology)
        
        baseline_probs = run_quantum_evolution(
            H_base, transition_map, self.dim, 
            steps=5, dt=dt
        )
        
        state_probabilities = self._aggregate_probabilities(baseline_probs)
        
        active_nodes = baseline_state.get("active_nodes", set())
        suppressed_nodes = baseline_state.get("suppressed_nodes", set())
        
        for node in active_nodes:
            state_probabilities[node] += 1.0
        for node in suppressed_nodes:
            state_probabilities[node] *= 0.1
        
        sorted_states = sorted(
            state_probabilities.keys(),
            key=lambda x: state_probabilities[x],
            reverse=True
        )
        dominant_states = set(sorted_states[:len(sorted_states) // 2])
        
        novelty_target = intention["target"]
        steering_sources = intention.get("sources", list(dominant_states)[:10])
        modulation_strength = intention.get("modulation_strength", 0.5)
        steering_strength = intention.get("steering_strength", 1.2)
        
        H_modulated = apply_neuromodulation(
            H_base, self.topology.neighbors, novelty_target, modulation_strength
        )
        
        H_intention = apply_intention_steering(
            H_modulated, set(steering_sources), novelty_target, steering_strength
        )
        
        intentional_probs = run_quantum_evolution(
            H_intention, transition_map, self.dim,
            steps=evolution_steps, dt=dt
        )
        
        reductions = {}
        for t in transition_map.keys():
            base_prob = baseline_probs.get(t, 0.0)
            intent_prob = intentional_probs.get(t, 0.0)
            if base_prob > intent_prob:
                reductions[t] = base_prob - intent_prob
        
        red_values = list(reductions.values())
        gini = calculate_gini(red_values)
        friction = calculate_friction(reductions, len(transition_map))
        
        baseline_target_prob = state_probabilities.get(novelty_target, 0.0)
        intentional_target_inflow = sum(
            prob for (src, tgt), prob in intentional_probs.items()
            if tgt == novelty_target
        )
        amplification = calculate_amplification(
            baseline_target_prob, intentional_target_inflow
        )
        
        sorted_by_reduction = sorted(
            reductions.keys(),
            key=lambda t: reductions[t],
            reverse=True
        )
        total_reduction = sum(red_values)
        top_10_pct = max(1, int(len(sorted_by_reduction) * 0.10))
        top_25_pct = max(1, int(len(sorted_by_reduction) * 0.25))
        
        mass_top_10 = sum(reductions[t] for t in sorted_by_reduction[:top_10_pct])
        mass_top_25 = sum(reductions[t] for t in sorted_by_reduction[:top_25_pct])
        
        top_10_mass = mass_top_10 / total_reduction if total_reduction > 0 else 0.0
        top_25_mass = mass_top_25 / total_reduction if total_reduction > 0 else 0.0
        
        harmony_score = calculate_harmony_score(amplification, gini, friction)
        
        return HarmonyResult(
            harmony_score=harmony_score,
            amplification=amplification,
            gini=gini,
            friction=friction,
            total_reductions=len(reductions),
            top_10_mass=top_10_mass,
            top_25_mass=top_25_mass
        )
    
    def _aggregate_probabilities(self, transition_probs: Dict) -> Dict[int, float]:
        """Aggregate transition probabilities into per-state probabilities."""
        state_probs = {i: 0.0 for i in range(self.dim)}
        for (src, tgt), prob in transition_probs.items():
            state_probs[src] += prob
            state_probs[tgt] += prob
        return state_probs
    
    def calculate_control(self, 
                         baseline_state: Dict,
                         num_constrained: int = 150) -> HarmonyResult:
        """
        Calculate control condition (blind suppression) for comparison.
        """
        H_base, transition_map = build_hamiltonian(self.topology)
        
        baseline_probs = run_quantum_evolution(
            H_base, transition_map, self.dim, steps=5
        )
        
        constrained_states = set(random.sample(range(self.dim), num_constrained))
        H_suppressed = apply_blind_suppression(H_base, constrained_states)
        
        suppressed_probs = run_quantum_evolution(
            H_suppressed, transition_map, self.dim, steps=8
        )
        
        reductions = {}
        for t in transition_map.keys():
            base_prob = baseline_probs.get(t, 0.0)
            supp_prob = suppressed_probs.get(t, 0.0)
            if base_prob > supp_prob:
                reductions[t] = base_prob - supp_prob
        
        red_values = list(reductions.values())
        gini = calculate_gini(red_values)
        friction = calculate_friction(reductions, len(transition_map))
        
        sorted_by_reduction = sorted(
            reductions.keys(),
            key=lambda t: reductions[t],
            reverse=True
        )
        total_reduction = sum(red_values)
        top_10_pct = max(1, int(len(sorted_by_reduction) * 0.10))
        top_25_pct = max(1, int(len(sorted_by_reduction) * 0.25))
        
        mass_top_10 = sum(reductions[t] for t in sorted_by_reduction[:top_10_pct])
        mass_top_25 = sum(reductions[t] for t in sorted_by_reduction[:top_25_pct])
        
        top_10_mass = mass_top_10 / total_reduction if total_reduction > 0 else 0.0
        top_25_mass = mass_top_25 / total_reduction if total_reduction > 0 else 0.0
        
        harmony_score = calculate_harmony_score(1.0, gini, friction)
        
        return HarmonyResult(
            harmony_score=harmony_score,
            amplification=1.0,
            gini=gini,
            friction=friction,
            total_reductions=len(reductions),
            top_10_mass=top_10_mass,
            top_25_mass=top_25_mass
        )


